#!/usr/bin/env bash
# Installs and configures HAProxy to round-robin traffic between web-01 and web-02
apt-get update -y
apt-get install -y haproxy
cp /etc/haproxy/haproxy.cfg /etc/haproxy/haproxy.cfg.bak
if ! grep -q "backend web_servers" /etc/haproxy/haproxy.cfg; then
  cat >> /etc/haproxy/haproxy.cfg << 'CFG'

frontend http_front
    bind *:80
    mode http
    default_backend web_servers

backend web_servers
    mode http
    balance roundrobin
    server 7304-web-01 16.61.221.45:80 check
    server 7304-web-02 35.178.55.166:80 check
CFG
fi
sed -i 's/ENABLED=0/ENABLED=1/' /etc/default/haproxy
service haproxy restart
