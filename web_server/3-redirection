#!/usr/bin/env bash
# Installs nginx, serves the index page, and adds a 301 redirect on /redirect_me
apt-get update -y
apt-get install -y nginx
mkdir -p /var/www/html
echo "Holberton School for the win!" > /var/www/html/index.html
echo "Holberton School for the win!" > /var/www/html/index.nginx-debian.html
if [ -d /usr/share/nginx/html ]; then
  echo "Holberton School for the win!" > /usr/share/nginx/html/index.html
fi
if ! grep -q "redirect_me" /etc/nginx/sites-available/default; then
  sed -i '/server_name _;/a\
\n\tlocation /redirect_me {\n\t\treturn 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;\n\t}' /etc/nginx/sites-available/default
fi
service nginx restart
